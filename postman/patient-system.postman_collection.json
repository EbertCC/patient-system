  "item": [
    {
      "name": "registro",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Registro exitoso\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"No expone password\", function () {\r",
              "    pm.expect(pm.response.text()).to.not.include(\"password\");\r",
              "});\r",
              "\r",
              "if (json.id) {\r",
              "    pm.collectionVariables.set(\"patientId\", json.id);\r",
              "}\r",
              "\r",
              "if (json.patientId) {\r",
              "    pm.collectionVariables.set(\"patientId\", json.patientId);\r",
              "}\r",
              "\r",
              "console.log(\"PATIENT ID:\", pm.collectionVariables.get(\"patientId\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now();\r",
              "\r",
              "pm.collectionVariables.set(\"email\", `prueba_${suffix}@email.com`);\r",
              "pm.collectionVariables.set(\"password\", \"secreto_123\");\r",
              "pm.collectionVariables.set(\"phone\", \"9\" + String(suffix).slice(-8));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{json_web_token_14s2}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\",\r\n  \"name\": \"usuario_prueba\",\r\n  \"phone\": \"{{phone}}\",\r\n  \"medicalHistory\": \"ninguno\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "localhost:8085/api/patients/register",
          "host": [
            "localhost"
          ],
          "port": "8085",
          "path": [
            "api",
            "patients",
            "register"
          ]
        }
      },
