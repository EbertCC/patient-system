    {
      "name": "agregar cita",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const minutesToAdd = 7 * 24 * 60 + Math.floor(Math.random() * 10000);\r",
              "const appointmentDate = new Date(Date.now() + minutesToAdd * 60 * 1000);\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"appointmentTime\",\r",
              "    appointmentDate.toISOString().slice(0, 19)\r",
              ");\r",
              "\r",
              "console.log(\"APPOINTMENT TIME:\", pm.collectionVariables.get(\"appointmentTime\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Cita creada correctamente\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"Estado SCHEDULED\", function () {\r",
              "    pm.expect(json.status).to.eql(\"SCHEDULED\");\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"appointmentId\", json.id);\r",
              "\r",
              "console.log(\"APPOINTMENT ID:\", pm.collectionVariables.get(\"appointmentId\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
